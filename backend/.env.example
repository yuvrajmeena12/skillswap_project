# Get a free MongoDB Atlas connection string (see README for step-by-step)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/skillswap

# Any long random string
JWT_SECRET=replace_this_with_a_long_random_secret

PORT=5000

# Frontend URL allowed to call this API
CLIENT_URL=http://localhost:5173

# OPTIONAL — for "Forgot Password" to send real emails instead of showing
# the reset link directly in the UI. Use a Gmail address + an App Password
# (not your normal Gmail password — generate one at myaccount.google.com/apppasswords).
# If left blank, forgot-password still works: the reset link is returned
# directly in the API response and shown on the Forgot Password page.
EMAIL_USER=
EMAIL_PASS=
